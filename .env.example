# ============================================================
# NEXUS-GH ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# ── Supabase (required) ───────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ── Vercel deployment ─────────────────────────────────────────
# Set these in: Vercel Dashboard → Project → Settings → Environment Variables
# (same keys as above — Vercel uses VITE_ prefix for client-side access)

# ── Supabase Edge Function Secrets ───────────────────────────
# Set in: Supabase Dashboard → Edge Functions → Manage Secrets
#
# send-notifications (email digest via Resend)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# FROM_EMAIL=Nexus-GH <noreply@yourdomain.com>
#
# momo-collect (Hubtel MoMo payments)
# HUBTEL_CLIENT_ID=your-hubtel-client-id
# HUBTEL_CLIENT_SECRET=your-hubtel-client-secret
#
# These are auto-injected by the Supabase runtime:
# SUPABASE_URL          (do not set manually)
# SUPABASE_SERVICE_ROLE_KEY  (do not set manually)
